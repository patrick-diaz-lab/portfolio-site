---
// Page shell for every page (PLAN 1.1): self-hosted fonts, tokens, base styles. No
// third-party requests: the fonts are bundled from @fontsource (Latin subset only).
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-400-italic.css";
import "@fontsource/barlow/latin-600.css";
import "@fontsource/barlow-condensed/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
// The three faces of the first paint, preloaded so the swap from the fallback font doesn't
// shift the layout (Lighthouse CLS on long part pages, PLAN 1.5).
import fontBody from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";
import fontPanel from "@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url";
import fontMono from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/base.css";
import { localePath, t, type Locale } from "../i18n/ui.ts";
import { SITE } from "../site.ts";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** The page's language (PLAN 1.9a). */
  lang?: Locale;
  /** The page's path without the /de prefix, when it exists in both languages: drives the
   *  language switch and the hreflang alternates. Pages in one language only leave it out. */
  path?: string;
}
const { title, description, noindex = false, lang = "en", path } = Astro.props;
const other: Locale = lang === "en" ? "de" : "en";
const home = localePath(lang, "/");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1e2225" />
    {[fontBody, fontPanel, fontMono].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <!-- Inline icon (an amber signal dot): no extra request, no /favicon.ico 404 (PLAN 1.3). -->
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='2' fill='%231e2225'/%3E%3Ccircle cx='8' cy='8' r='4' fill='%23f2b23e'/%3E%3C/svg%3E" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {path && (["en", "de"] as const).map((l) => <link rel="alternate" hreflang={l} href={SITE.origin + localePath(l, path)} />)}
    {path && <link rel="alternate" hreflang="x-default" href={SITE.origin + path} />}
  </head>
  <body>
    <header class="site-bar">
      <a class="site-name" href={home}>{t(lang, "site.name")}</a>
      {path && (
        <nav aria-label={t(lang, "lang.switch")} class="lang-switch">
          <span aria-current="true" lang={lang}>{t(lang, `lang.${lang}`)}</span>
          <a href={localePath(other, path)} hreflang={other} lang={other}>{t(other, `lang.${other}`)}</a>
        </nav>
      )}
    </header>
    <slot />
    <footer class="site-foot">
      <a href={localePath(lang, "/privacy/")}>{t(lang, "footer.privacy")}</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </footer>
  </body>
</html>
