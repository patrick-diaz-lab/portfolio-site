---
// The piece map (PLAN 1.3, D7, D13): the hand-drawn schematic with every part as a named
// link, and the list of all parts under it. The list works without JS and is the phone
// layout: a vertical wire with the modules along it.
// Layout A (Patrick, 2026-11-13): with JS on a wide screen, a panel next to the drawing shows
// one part at a time (line, number, text, "Read the page", previous/next), and the list
// becomes a compact index of names by line. The panel replaces the floating card; it keeps
// the card's data-card hooks, so the no-JS gate treats its text as script-made.
// Per language (PLAN 1.9a): labels, hover texts and the schematic's texts come from the
// piece's data in that language; links to part pages that exist only in English are marked.
import { lineName, t, type Locale } from "../i18n/ui.ts";
import { linkParts, partHref, type MapPart, type SvgText } from "../lib/map-svg.ts";
import "../styles/schematic.css";

interface Props {
  svg: string;
  parts: MapPart[];
  locale?: Locale;
  svgText?: SvgText;
}
const { svg, parts, locale = "en", svgText = {} } = Astro.props;
const drawing = linkParts(svg, parts, svgText);
const anyEnglish = parts.some((p) => p.page && p.pageLang);
// The list groups the parts by line, each line once, in the order the lines first appear;
// the parts' own order (map.yaml) numbers them and need not keep a line together (2026-11-20).
const groups: { line: string; parts: MapPart[] }[] = [];
for (const p of parts) {
  const line = p.line ?? "parts";
  let g = groups.find((x) => x.line === line);
  if (!g) groups.push((g = { line, parts: [] }));
  g.parts.push(p);
}
---
<div class="piece-map" data-map data-start={parts.find((p) => p.start)?.id}>
  <section class="map" aria-labelledby="h-map">
    <h2 id="h-map" class="label">{t(locale, "map.schematic")}</h2>
    <div class="map-body">
      <div class="map-frame plate">
        <Fragment set:html={drawing} />
      </div>
      <aside class="map-card" data-card hidden aria-label={t(locale, "map.selected")}>
        <p class="label" data-card-meta></p>
        <h3 class="map-card-title" data-card-title></h3>
        <p class="map-card-text" data-card-text></p>
        <p class="map-card-links">
          <a class="map-card-open button is-quiet" data-card-open href="#h-parts">{t(locale, "map.readPage")} →</a>
          {anyEnglish && <span class="label" data-card-english>{t(locale, "map.englishPage")}</span>}
        </p>
        <div class="map-card-nav">
          <button type="button" data-card-prev>← {t(locale, "map.prev")}</button>
          <button type="button" data-card-next>{t(locale, "map.next")} →</button>
        </div>
      </aside>
    </div>
  </section>

  <section class="parts" aria-labelledby="h-parts">
    <h2 id="h-parts">{t(locale, "map.allParts")}</h2>
    <ol class="wire-list">
      {groups.map((g) => (
        <li class="wire-group">
          <p class="label wire-line">{lineName(locale, g.line)}</p>
          <ol>
            {g.parts.map((p) => (
              <li class="wire-item" id={`part-${p.id}`}>
                <a class="wire-name" href={partHref(p)} hreflang={p.page && p.pageLang ? p.pageLang : undefined}>{p.label}</a>
                {p.page && p.pageLang && <span class="label">{t(locale, "map.englishPage")}</span>}
                <p id={`desc-${p.id}`}>{p.hover}</p>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </section>
</div>

<script>
  import { initMap } from "../scripts/map.ts";
  for (const el of document.querySelectorAll<HTMLElement>("[data-map]")) initMap(el);
</script>

<style is:global>
  .piece-map { display: grid; gap: var(--space-16); }
  .map { display: grid; gap: var(--space-3); }

  /* The drawing on its plate and, with JS, the panel beside it; the panel wraps under a
     narrow drawing. */
  .map-body { display: flex; flex-wrap: wrap; gap: var(--space-6) var(--space-8); align-items: stretch; }
  .map-frame { position: relative; flex: 3 1 36rem; min-width: 0; }
  .map-frame .schematic { display: block; width: 100%; height: auto; }

  /* The panel: one part at a time, next to the drawing, under an orange rule. */
  .map-card {
    flex: 1 1 15rem; min-width: 0;
    border-top: var(--line-rule) solid var(--color-accent);
    padding-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-3);
  }
  .map-card[hidden], .map-card [hidden] { display: none; }
  .map-card-title { font-size: var(--step-2); }
  .map-card-text { font-size: 1rem; line-height: 1.55; }
  .map-card-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: center; }
  .map-card-nav { margin-top: auto; display: flex; justify-content: space-between; gap: var(--space-2); border-top: var(--line-thin) solid var(--color-border); padding-top: var(--space-2); }
  .map-card-nav button { background: none; border: 0; color: var(--color-text); font: 400 var(--step--2) var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; min-height: 2.75rem; padding: 0 var(--space-1); cursor: pointer; }
  .map-card-nav button:hover { box-shadow: inset 0 -2px 0 var(--color-accent); }

  /* The list: a vertical wire with the parts along it (D13). */
  .parts { display: grid; gap: var(--space-6); border-top: var(--line-rule) solid var(--color-text); padding-top: var(--space-4); }
  .wire-list, .wire-list ol { list-style: none; margin: 0; padding: 0; }
  .wire-list { display: grid; gap: var(--space-6); max-width: 46rem; border-left: var(--line-module) solid var(--color-text); padding-left: var(--space-6); }
  .wire-group { display: grid; gap: var(--space-3); }
  .wire-line { position: relative; }
  .wire-line::before { content: ""; position: absolute; left: calc(-1 * var(--space-6) - 6.5px); top: 0.25em; width: 12px; height: 12px; border-radius: 50%; background: var(--color-bg); border: var(--line-module) solid var(--color-text); }
  .wire-group > ol { display: grid; gap: var(--space-4); }
  .wire-item { position: relative; display: grid; gap: var(--space-1); scroll-margin-top: var(--space-8); }
  .wire-item::before { content: ""; position: absolute; left: calc(-1 * var(--space-6)); top: 0.95rem; width: var(--space-4); border-top: var(--line-module) solid var(--color-text); }
  .wire-item:target .wire-name { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
  .wire-name { font: 700 var(--step-1) / var(--leading-tight) var(--font-display); letter-spacing: -0.015em; text-decoration-color: transparent; justify-self: start; padding-block: var(--space-1); }
  .wire-name:hover { text-decoration-color: var(--color-accent); }
  .wire-item p { font-size: 1rem; line-height: 1.5; }

  /* With JS on a wide screen, the list is a compact index: names by line, the texts live in
     the panel (layout A). Without JS, and on phones, it stays the full vertical wire. */
  @media (min-width: 48rem) {
    .piece-map.is-enhanced .wire-list { max-width: none; border-left: 0; padding-left: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); align-items: start; gap: var(--space-6) var(--space-8); }
    .is-enhanced .wire-group { border-top: var(--line-thin) solid var(--color-border); padding-top: var(--space-3); gap: var(--space-1); }
    .is-enhanced .wire-line::before, .is-enhanced .wire-item::before { display: none; }
    .is-enhanced .wire-group > ol { gap: 0; }
    .is-enhanced .wire-item { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-2); }
    .is-enhanced .wire-item p { display: none; }
    .is-enhanced .wire-name { display: inline-flex; align-items: center; gap: var(--space-3); min-height: 2.75rem; font-size: var(--step-0); padding-block: 0; }
    .is-enhanced .wire-name::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; border: var(--line-module) solid currentColor; }
    .is-enhanced .wire-item.is-selected .wire-name { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
    .is-enhanced .wire-item.is-selected .wire-name::before { background: var(--color-accent-strong); border-color: var(--color-accent-strong); }
  }

  /* Phones: the schematic gives way to the vertical wire (D13). */
  @media (max-width: 47.99rem) {
    .map { display: none; }
  }
</style>
