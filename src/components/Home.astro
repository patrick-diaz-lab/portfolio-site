---
// Homepage (PLAN 1.9a, D18), English at / and German at /de/. Text from content/home/<locale>.yaml,
// which Patrick edits; contact facts from src/site.ts. No photo, no CV download, no
// personal email; the employer only generically. Not indexed until launch (PLAN 1.9b).
//
// Layout "A2" (Patrick, 2026-11-13): intro and featured piece side by side, "All pieces" once
// there is more than one built piece, work lines tagged with their piece and part, then
// contact. Only built pieces appear, with no status labels.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";
import Base from "../layouts/Base.astro";
import Chips from "./Chips.astro";
import { homeSchema } from "../content/schemas.ts";
import { localePath, t, type Locale } from "../i18n/ui.ts";
import { chipValue } from "../lib/chips.ts";
import { loadPieces, type Piece } from "../lib/pieces.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const home = homeSchema.parse(parse(readFileSync(join(process.cwd(), "content", "home", `${locale}.yaml`), "utf8")));

// Built pieces in this language; a piece without German text shows in English, marked.
const local = new Map(loadPieces(locale).map((p) => [p.id, p]));
const pieces = loadPieces("en").map((en) => {
  const piece: Piece = local.get(en.id) ?? en;
  const english = !local.has(en.id);
  return { piece, english, href: english ? `/${en.id}/` : localePath(locale, `/${en.id}/`) };
});
const featured = pieces.find((p) => p.piece.id === home.featured.piece);
const num = (p: Piece) => String(p.order).padStart(2, "0");

// A link to a page that exists only in English is marked on German pages.
const englishOnly = (href: string) => locale !== "en" && !href.startsWith(`/${locale}/`);
// Each work line names its piece and part, from the link: /<piece>/<part>/.
const workTag = (href: string) => {
  const [, pid, partId] = href.split("/");
  const p = pieces.find((x) => x.piece.id === pid)?.piece;
  if (!p) return "";
  return [p.title, p.parts.find((x) => x.id === partId)?.label].filter(Boolean).join(" · ");
};
const cvHref = `mailto:${SITE.email}?subject=${encodeURIComponent(home.cv)}`;
---
<Base title={home.title} description={home.description} noindex lang={locale} path="/">
  <main class="page home">
    <div class="top">
      <header class="intro">
        <p class="label">{t(locale, "site.role")}</p>
        <h1>Patrick Diaz</h1>
        <p class="positioning">{home.positioning}</p>
        {home.background.map((p) => <p>{p}</p>)}
        <p class="jump">
          <a class="button" href="#h-contact">{home.contact_heading} →</a>
          <a href="#h-work">{home.work_heading}</a>
        </p>
      </header>

      {featured && (
        <section class="featured module" aria-labelledby="h-featured" lang={featured.english ? "en" : undefined}>
          <div class="featured-head">
            <p class="label">{t(locale, "piece.label")} {num(featured.piece)}</p>
            <span class="dot" aria-hidden="true"></span>
          </div>
          <h2 id="h-featured">{featured.piece.title}</h2>
          <p class="featured-tagline">{featured.piece.tagline}</p>
          <Chips chips={featured.piece.chips} locale={locale} variant="panel" />
          <a class="button" href={featured.href} hreflang={featured.english ? "en" : undefined}>{home.featured.cta} →</a>
        </section>
      )}
    </div>

    {pieces.length > 1 && (
      <section class="pieces" aria-labelledby="h-pieces">
        <div class="rule-head">
          <h2 id="h-pieces">{t(locale, "home.pieces")}</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <ul>
          {pieces.map(({ piece, english, href }) => {
            const chip = piece.chips[0];
            return (
              <li class="module piece-row" lang={english ? "en" : undefined}>
                <p class="label">{t(locale, "piece.label")} {num(piece)}</p>
                <div class="piece-text">
                  <a class="piece-title" href={href} hreflang={english ? "en" : undefined}>{piece.title}</a>
                  {english && <span class="label" lang={locale}> {t(locale, "map.englishPage")}</span>}
                  <p>{piece.tagline}</p>
                </div>
                {chip && (
                  <p class="piece-stat">
                    <span class="piece-stat-value">{chipValue(chip, locale)}</span>
                    <span class="label">{chip.label}</span>
                  </p>
                )}
                <a class="piece-cta" href={href} hreflang={english ? "en" : undefined}>{t(locale, "piece.openMap")} →</a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="work" aria-labelledby="h-work">
      <div class="rule-head">
        <h2 id="h-work">{home.work_heading}</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>
      <ul>
        {home.work.map((w) => (
          <li class="work-item">
            {workTag(w.href) && <p class="label">{workTag(w.href)}</p>}
            <a href={w.href} hreflang={englishOnly(w.href) ? "en" : undefined}>{w.title}</a>
            {englishOnly(w.href) && <span class="label"> {t(locale, "map.englishPage")}</span>}
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact" aria-labelledby="h-contact">
      <div class="contact-text">
        <h2 id="h-contact">{home.contact_heading}</h2>
        <p>{home.contact_text}</p>
      </div>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.github} rel="me">GitHub</a></li>
        <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
        <li class="label"><a href={cvHref}>{home.cv}</a></li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .home { gap: var(--space-16); }

  /* Intro and featured piece, side by side; stacked on a phone. */
  .top { display: flex; flex-wrap: wrap; gap: var(--space-12); align-items: start; }
  .intro { flex: 1 1 22rem; min-width: 0; display: grid; gap: var(--space-4); }
  .intro h1 { font-size: clamp(var(--step-4), 6vw, 3.2rem); line-height: 1.05; }
  .positioning { font-size: var(--step-2); line-height: 1.3; max-width: 24ch; }
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; margin-top: var(--space-2); }
  .jump a:not(.button) { font: 400 var(--step--1) var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; padding-block: var(--space-3); }

  .button { display: inline-block; font: 400 var(--step--1) var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; padding: var(--space-3) var(--space-4); border: var(--line-thin) solid var(--color-silk); border-radius: var(--radius); text-decoration: none; }
  .button:hover { border-color: var(--color-amber); }

  .featured { flex: 1 1 26rem; min-width: 0; display: grid; gap: var(--space-3); padding: var(--space-6); }
  .featured-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-amber); }
  .featured h2 { font-size: var(--step-3); }
  .featured-tagline { font-size: var(--step-1); line-height: 1.4; }
  .featured .button { justify-self: start; margin-top: var(--space-2); }

  /* Section heads with a rule running to the edge. */
  .rule-head { display: flex; align-items: center; gap: var(--space-4); }
  .rule-head h2 { flex: 0 1 auto; }
  .rule { flex: 1 1 2rem; height: var(--line-thin); background: var(--color-silk-dim); }

  .pieces, .work { display: grid; gap: var(--space-6); }
  .pieces ul, .work ul, .contact ul { list-style: none; margin: 0; padding: 0; }

  .pieces ul { display: grid; gap: var(--space-3); }
  .piece-row { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-8); align-items: center; padding: var(--space-4) var(--space-6); }
  .piece-text { flex: 3 1 20rem; min-width: 0; display: grid; gap: 2px; }
  .piece-title { font: 600 var(--step-2) / var(--leading-tight) var(--font-panel); letter-spacing: var(--tracking-panel); text-transform: uppercase; text-decoration: none; justify-self: start; }
  .piece-title:hover { text-decoration: underline; }
  .piece-text p { font-size: var(--step--1); }
  .piece-stat { flex: 1 1 11rem; display: grid; gap: 2px; }
  .piece-stat-value { font: 400 var(--step-1) / 1.2 var(--font-mono); }
  .piece-cta { font: 400 var(--step--1) var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; padding-block: var(--space-3); }

  /* Two columns at most, so four lines make a 2×2 grid. */
  .work ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: var(--space-4); }
  .work-item { border: var(--line-module) solid var(--color-silk); border-radius: var(--radius); padding: var(--space-4) var(--space-6) var(--space-6); display: grid; gap: var(--space-2); align-content: start; }
  .work-item a { font: 600 var(--step-1) / var(--leading-tight) var(--font-panel); letter-spacing: var(--tracking-panel); text-transform: uppercase; text-decoration: none; justify-self: start; }
  .work-item a:hover { text-decoration: underline; }
  .work-item p:not(.label) { font-size: var(--step--1); }

  .contact { border-top: var(--line-module) solid var(--color-silk); padding-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-6) var(--space-12); align-items: start; }
  .contact-text { flex: 1 1 20rem; display: grid; gap: var(--space-3); }
  .contact ul { flex: 1 1 20rem; display: grid; gap: var(--space-1); }
  .contact ul a { display: inline-block; padding-block: var(--space-2); font-family: var(--font-mono); }
  .contact .label { padding-top: var(--space-2); }
  .contact .label a { color: inherit; }
</style>
