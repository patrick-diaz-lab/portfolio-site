---
// Homepage (PLAN 1.9a, D18), English at / and German at /de/. Text from content/home/<locale>.yaml,
// which Patrick edits; contact facts from src/site.ts. No photo, no CV download, no
// personal email; the employer only generically. Not indexed until launch (PLAN 1.9b).
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";
import Base from "../layouts/Base.astro";
import Chips from "./Chips.astro";
import { homeSchema } from "../content/schemas.ts";
import { localePath, t, type Locale } from "../i18n/ui.ts";
import { loadPieces } from "../lib/pieces.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const home = homeSchema.parse(parse(readFileSync(join(process.cwd(), "content", "home", `${locale}.yaml`), "utf8")));
const piece = loadPieces(locale).find((p) => p.id === home.featured.piece);
// A link to a page that exists only in English is marked on German pages.
const englishOnly = (href: string) => locale !== "en" && !href.startsWith(`/${locale}/`);
const cvHref = `mailto:${SITE.email}?subject=${encodeURIComponent(home.cv)}`;
---
<Base title={home.title} description={home.description} noindex lang={locale} path="/">
  <main class="page home">
    <header class="home-head">
      <p class="label">{t(locale, "site.role")}</p>
      <h1>Patrick Diaz</h1>
      <p class="positioning">{home.positioning}</p>
      {home.background.map((p) => <p>{p}</p>)}
    </header>

    {piece && (
      <section class="featured module" aria-labelledby="h-featured">
        <p class="label">{t(locale, "piece.label")} {String(piece.order).padStart(2, "0")}</p>
        <h2 id="h-featured">{piece.title}</h2>
        <p class="featured-tagline">{piece.tagline}</p>
        <Chips chips={piece.chips} locale={locale} />
        <a class="featured-cta" href={localePath(locale, `/${piece.id}/`)}>{home.featured.cta} →</a>
      </section>
    )}

    <section class="work" aria-labelledby="h-work">
      <h2 id="h-work">{home.work_heading}</h2>
      <ul>
        {home.work.map((w) => (
          <li>
            <a href={w.href} hreflang={englishOnly(w.href) ? "en" : undefined}>{w.title}</a>
            {englishOnly(w.href) && <span class="label"> {t(locale, "map.englishPage")}</span>}
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact" aria-labelledby="h-contact">
      <h2 id="h-contact">{home.contact_heading}</h2>
      <p>{home.contact_text}</p>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.github} rel="me">GitHub</a></li>
        <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
      </ul>
      <p class="label"><a href={cvHref}>{home.cv}</a></p>
    </section>
  </main>
</Base>

<style>
  .home { max-width: 52rem; }
  .home-head { display: grid; gap: var(--space-4); }
  .home-head h1 { font-size: var(--step-4); }
  .positioning { font-size: var(--step-2); line-height: 1.3; max-width: 34ch; }
  .featured { display: grid; gap: var(--space-3); padding: var(--space-6); }
  .featured-tagline { font-size: var(--step-1); line-height: 1.4; }
  .featured-cta { justify-self: start; font: 400 var(--step--1) var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; padding: var(--space-3) var(--space-4); border: var(--line-thin) solid var(--color-silk); text-decoration: none; margin-top: var(--space-2); }
  .featured-cta:hover { border-color: var(--color-amber); }
  .work, .contact { display: grid; gap: var(--space-4); }
  .work ul, .contact ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .work li { border-left: var(--focus-width) solid var(--color-amber); padding-left: var(--space-4); display: grid; gap: var(--space-1); }
  .work li a { font: 600 var(--step-1) / var(--leading-tight) var(--font-panel); letter-spacing: var(--tracking-panel); text-transform: uppercase; text-decoration: none; justify-self: start; }
  .work li a:hover { text-decoration: underline; }
  .work li p { font-size: var(--step--1); }
  .contact ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); }
  .contact ul a { display: inline-block; padding-block: var(--space-2); font-family: var(--font-mono); }
  .contact .label a { color: inherit; }
</style>
