---
// Homepage (PLAN 1.9a, D18), English at / and German at /de/. Text from content/home/<locale>.yaml,
// which Patrick edits; contact facts from src/site.ts. No photo, no CV download, no
// personal email; the employer only generically. Indexed since PLAN 1.9b.
//
// The order is layout "A2" (Patrick, 2026-11-13): intro, the featured piece, "All pieces" once
// there is more than one built piece, work lines tagged with their piece and part, then
// contact. Only built pieces appear, with no status labels.
// Since D25 (PLAN 1.18): one statement in display type, then numbered sections; the featured
// piece shows its results under orange rules and its map as a figure that links to the piece.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";
import Base from "../layouts/Base.astro";
import Chips from "./Chips.astro";
import { homeSchema } from "../content/schemas.ts";
import { localePath, t, type Locale } from "../i18n/ui.ts";
import { chipValue } from "../lib/chips.ts";
import { plainDrawing } from "../lib/map-svg.ts";
import { loadPieces, partPath, type Piece } from "../lib/pieces.ts";
import "../styles/schematic.css";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const home = homeSchema.parse(parse(readFileSync(join(process.cwd(), "content", "home", `${locale}.yaml`), "utf8")));

// Built pieces in this language; a piece without German text shows in English, marked.
const local = new Map(loadPieces(locale).map((p) => [p.id, p]));
const pieces = loadPieces("en").map((en) => {
  const piece: Piece = local.get(en.id) ?? en;
  const english = !local.has(en.id);
  return { piece, english, href: english ? `/${en.id}/` : localePath(locale, `/${en.id}/`) };
});
const featured = pieces.find((p) => p.piece.id === home.featured.piece);
const num = (p: Piece) => String(p.order).padStart(2, "0");

// Work links name English part pages (the same list in both languages, `pnpm check`); a German
// homepage links the German version where one exists (Patrick, 2026-11-15).
const workHref = (href: string) => {
  const [, pid, partId] = href.split("/");
  return pid && partId ? partPath(locale, pid, partId, href).href : href;
};
// A link to a page that exists only in English is marked on German pages.
const englishOnly = (href: string) => locale !== "en" && !href.startsWith(`/${locale}/`);
// Each work line names its piece and part, from the link: /<piece>/<part>/.
const workTag = (href: string) => {
  const [, pid, partId] = href.split("/");
  const p = pieces.find((x) => x.piece.id === pid)?.piece;
  if (!p) return "";
  return [p.title, p.parts.find((x) => x.id === partId)?.label].filter(Boolean).join(" · ");
};
// Sections after the intro are numbered in the order they appear.
const no = (() => { let n = 0; return () => String(++n).padStart(2, "0"); })();
const cvHref = `mailto:${SITE.email}?subject=${encodeURIComponent(home.cv)}`;
---
<Base title={home.title} description={home.description} lang={locale} path="/">
  <main id="main" class="page home">
    <header class="hero">
      <h1 class="label hero-kicker">Patrick Diaz <span aria-hidden="true">—</span> {t(locale, "site.role")}</h1>
      <p class="display">{home.positioning}</p>
      <div class="hero-grid">
        <div class="hero-side">
          {home.looking_for && <p class="lead marked">{home.looking_for}</p>}
        </div>
        <div class="hero-text">
          {home.background.map((p) => <p>{p}</p>)}
          <p class="jump">
            <a class="button" href="#h-contact">{home.contact_heading} →</a>
            <a class="more" href="#h-work">{home.work_heading}</a>
          </p>
        </div>
      </div>
    </header>

    {featured && (
      <section class="sec featured" aria-labelledby="h-featured" lang={featured.english ? "en" : undefined}>
        <p class="sec-n" aria-hidden="true">{no()}</p>
        <p class="label">{t(locale, "piece.label")} {num(featured.piece)} · {t(locale, "piece.asOf")} {featured.piece.as_of}</p>
        <h2 id="h-featured" class="featured-title">{featured.piece.title}</h2>
        <p class="lead featured-tagline">{featured.piece.tagline}</p>
        <Chips chips={featured.piece.chips} locale={locale} footnote={featured.piece.chips_note} />
        <figure class="home-fig">
          <a class="home-fig-link" href={featured.href} hreflang={featured.english ? "en" : undefined}>
            <span class="vh">{home.featured.cta}</span>
            <div class="plate"><Fragment set:html={plainDrawing(featured.piece.svg, featured.piece.parts, featured.piece.svgText)} /></div>
          </a>
          <figcaption><span class="label">{t(locale, "home.figure")} 1</span> {featured.piece.title}: {featured.piece.parts.length} {t(locale, "home.parts")}. <a class="more" href={featured.href} hreflang={featured.english ? "en" : undefined}>{home.featured.cta} →</a></figcaption>
        </figure>
      </section>
    )}

    {pieces.length > 1 && (
      <section class="sec pieces" aria-labelledby="h-pieces">
        <p class="sec-n" aria-hidden="true">{no()}</p>
        <h2 id="h-pieces">{t(locale, "home.pieces")}</h2>
        <ul class="rows">
          {pieces.map(({ piece, english, href }) => {
            const chip = piece.chips[0];
            return (
              <li class="piece-row" lang={english ? "en" : undefined}>
                <p class="label">{t(locale, "piece.label")} {num(piece)}</p>
                <div class="piece-text">
                  <a class="row-title" href={href} hreflang={english ? "en" : undefined}>{piece.title}</a>
                  {english && <span class="label" lang={locale}> {t(locale, "map.englishPage")}</span>}
                  <p>{piece.tagline}</p>
                </div>
                {chip && (
                  <p class="piece-stat">
                    <span class="piece-stat-value">{chipValue(chip, locale)}</span>
                    <span class="label">{chip.label}</span>
                  </p>
                )}
                <a class="more" href={href} hreflang={english ? "en" : undefined}>{t(locale, "piece.openMap")} →</a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="sec work" aria-labelledby="h-work">
      <p class="sec-n" aria-hidden="true">{no()}</p>
      <h2 id="h-work">{home.work_heading}</h2>
      <ul class="rows">
        {home.work.map((w) => (
          <li class="work-item">
            <a class="row-title" href={workHref(w.href)} hreflang={englishOnly(workHref(w.href)) ? "en" : undefined}>{w.title}</a>
            {englishOnly(workHref(w.href)) && <span class="label"> {t(locale, "map.englishPage")}</span>}
            <p>{w.text}</p>
            {workTag(w.href) && <p class="label work-tag">{workTag(w.href)}</p>}
          </li>
        ))}
      </ul>
    </section>

    <section class="sec contact" aria-labelledby="h-contact">
      <p class="sec-n" aria-hidden="true">{no()}</p>
      <h2 id="h-contact">{home.contact_heading}</h2>
      <p>{home.contact_text}</p>
      <ul class="contact-links">
        <li class="contact-mail"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.github} rel="me">GitHub</a></li>
        <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={cvHref}>{home.cv}</a></li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .home { gap: var(--space-24); padding-top: var(--space-16); }

  /* The intro: one statement in display type, the rest on two columns under it. */
  .hero { display: grid; gap: var(--space-8); }
  .hero-kicker { font-weight: 400; color: var(--color-text); letter-spacing: var(--tracking-label); }
  .display { font: 700 clamp(2.25rem, 6.4vw, var(--step-5)) / var(--leading-display) var(--font-display); letter-spacing: var(--tracking-display); max-width: 17ch; text-wrap: balance; overflow-wrap: break-word; }
  .hero-grid { display: grid; gap: var(--space-6) var(--space-8); grid-template-columns: minmax(0, 1fr); }
  .hero-side, .hero-text { display: grid; gap: var(--space-6); align-content: start; min-width: 0; }
  .hero-side .lead { max-width: 22ch; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); } }
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-6); align-items: center; max-width: none; }

  /* The featured piece. */
  .featured-title { font-size: clamp(var(--step-3), 6vw, var(--step-4)); line-height: 1; }
  .featured-tagline { max-width: 34ch; }
  .home-fig { margin: var(--space-2) 0 0; display: grid; gap: var(--space-3); }
  .home-fig-link { display: block; text-decoration: none; }
  .home-fig-link:hover .plate { outline: var(--line-rule) solid var(--color-accent); outline-offset: -2px; }
  .home-fig :global(.schematic) { display: block; width: 100%; height: auto; }
  .home-fig figcaption { font-size: var(--step--1); line-height: 1.5; color: var(--color-text-secondary); }
  .home-fig figcaption .label { color: var(--color-text); margin-right: var(--space-2); }
  /* On a phone the lettering would be too small to read: the figure shows the drawing alone. */
  @media (max-width: 55.99rem) {
    .home-fig :global(.schematic text) { display: none; }
    .home-fig :global(.schematic :is(.box, .wire, .wire-static, .frame path, .frame rect, .dim, .terminal circle)) { vector-effect: non-scaling-stroke; stroke-width: 1px; }
  }

  /* Rows: the pieces, the work lines. */
  .rows, .contact-links { list-style: none; margin: 0; padding: 0; }
  .rows > li { display: grid; gap: var(--space-1) var(--space-8); padding-block: var(--space-6); border-top: var(--line-thin) solid var(--color-border); align-items: start; }
  .rows > li:first-child { border-top: 0; padding-top: 0; }
  .row-title { font: 700 var(--step-1) / 1.2 var(--font-display); letter-spacing: -0.015em; text-decoration-color: transparent; justify-self: start; display: inline-block; padding-block: 2px; }
  .row-title:hover, .row-title:focus-visible { text-decoration-color: var(--color-accent); }
  .rows p:not(.label) { font-size: 1rem; }
  .work-tag { margin-top: var(--space-1); }
  @media (min-width: 60rem) {
    .work-item { grid-template-columns: minmax(0, 1fr) 15rem; }
    .work-item > * { grid-column: 1; }
    .work-item > .work-tag { grid-column: 2; grid-row: 1 / span 2; margin-top: 0.5rem; }
    .piece-row { grid-template-columns: 6rem minmax(0, 3fr) minmax(0, 1.5fr) auto; }
  }
  .piece-text { display: grid; gap: 2px; min-width: 0; }
  .piece-stat { display: grid; gap: 2px; }
  .piece-stat-value { font: 700 var(--step-1) / 1.2 var(--font-display); }

  .contact-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); align-items: baseline; }
  .contact-links a { display: inline-block; padding-block: var(--space-2); font-weight: 600; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .contact-mail { flex: 1 1 100%; }
  .contact-mail a { font: 700 clamp(1.5rem, 5vw, var(--step-3)) / 1.1 var(--font-display); letter-spacing: var(--tracking-display); overflow-wrap: anywhere; }
</style>
