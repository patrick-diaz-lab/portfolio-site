---
// Piece overview (PLAN 1.3, D19), in English at /<piece>/ and in German at /de/<piece>/
// (PLAN 1.9a). Not indexed until launch (PLAN 1.9b). Layout A (Patrick, 2026-11-13): the
// intro and the metric chips side by side, as on the homepage, then the map.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";
import Base from "../layouts/Base.astro";
import Chips from "./Chips.astro";
import Map from "./Map.astro";
import { homeSchema } from "../content/schemas.ts";
import { localePath, t, type Locale } from "../i18n/ui.ts";
import { partPath, type Piece } from "../lib/pieces.ts";

interface Props {
  piece: Piece;
  locale: Locale;
}
const { piece, locale } = Astro.props;
const n = String(piece.order).padStart(2, "0");
const both = piece.locales.includes("de");
// Where to start (2026-11-20): the parts the homepage's work list names, under its titles,
// so ten parts of equal weight get an entry point. The list lives in content/home/.
const home = homeSchema.parse(parse(readFileSync(join(process.cwd(), "content", "home", `${locale}.yaml`), "utf8")));
const start = home.work.flatMap((w) => {
  const [, pid, partId] = w.href.split("/");
  return pid === piece.id && partId ? [{ title: w.title, ...partPath(locale, pid, partId, w.href) }] : [];
});
---
<Base title={`${piece.title} — Patrick Diaz`} description={piece.tagline} lang={locale} path={both ? `/${piece.id}/` : undefined}>
  <main class="page">
    <header class="piece-head">
      <div class="piece-intro">
        <p class="label"><a href={localePath(locale, "/")}>Patrick Diaz</a> · {t(locale, "piece.label")} {n}</p>
        <h1>{piece.title}</h1>
        <p class="piece-tagline">{piece.tagline}</p>
        <p>{piece.summary}</p>
        <p class="label">{t(locale, "piece.asOf")} {piece.as_of}</p>
      </div>
      {piece.chips.length > 0 && (
        <div class="piece-chips">
          <Chips chips={piece.chips} locale={locale} variant="panel" footnote={piece.chips_note} />
        </div>
      )}
    </header>
    {start.length > 0 && (
      <nav class="piece-start" aria-labelledby="h-start">
        <h2 id="h-start" class="label">{t(locale, "piece.startHere")}</h2>
        <ul>
          {start.map((s) => (
            <li><a href={s.href} hreflang={s.lang}>{s.title}</a>{s.lang && <span class="label"> {t(locale, "map.englishPage")}</span>}</li>
          ))}
        </ul>
      </nav>
    )}
    <Map svg={piece.svg} parts={piece.parts} locale={locale} svgText={piece.svgText} />
  </main>
</Base>

<style>
  .piece-head { display: flex; flex-wrap: wrap; gap: var(--space-8) var(--space-12); align-items: start; }
  .piece-intro { flex: 3 1 24rem; min-width: 0; display: grid; gap: var(--space-4); }
  .piece-intro h1 { font-size: clamp(var(--step-4), 6vw, 3.2rem); line-height: 1.05; }
  .piece-chips { flex: 2 1 20rem; min-width: 0; }
  .piece-head a { color: inherit; }
  /* The breadcrumb link gets a tap target of at least 24 px. */
  .piece-intro .label a { display: inline-block; padding-block: var(--space-1); }
  .piece-start { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); align-items: baseline; border-top: var(--line-thin) solid var(--color-silk-dim); border-bottom: var(--line-thin) solid var(--color-silk-dim); padding-block: var(--space-3); }
  .piece-start ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-6); }
  .piece-start a { display: inline-block; padding-block: var(--space-2); font: 600 var(--step-0) / 1.3 var(--font-panel); letter-spacing: var(--tracking-panel); text-transform: uppercase; text-decoration: none; }
  .piece-start a:hover { text-decoration: underline; }
  .piece-tagline { font-size: var(--step-1); line-height: 1.4; max-width: 40ch; }
</style>
