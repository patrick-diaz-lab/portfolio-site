---
// Piece overview (PLAN 1.3, D19), in English at /<piece>/ and in German at /de/<piece>/
// (PLAN 1.9a). Since D25 (PLAN 1.18): the title in display type, the tagline with its orange
// marker beside the summary, the results under orange rules, where to start, then the map.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";
import Base from "../layouts/Base.astro";
import Chips from "./Chips.astro";
import Map from "./Map.astro";
import { homeSchema } from "../content/schemas.ts";
import { localePath, t, type Locale } from "../i18n/ui.ts";
import { partPath, type Piece } from "../lib/pieces.ts";

interface Props {
  piece: Piece;
  locale: Locale;
}
const { piece, locale } = Astro.props;
const n = String(piece.order).padStart(2, "0");
const both = piece.locales.includes("de");
// Where to start (2026-11-20): the parts the homepage's work list names, under its titles,
// so ten parts of equal weight get an entry point. The list lives in content/home/.
const home = homeSchema.parse(parse(readFileSync(join(process.cwd(), "content", "home", `${locale}.yaml`), "utf8")));
const start = home.work.flatMap((w) => {
  const [, pid, partId] = w.href.split("/");
  return pid === piece.id && partId ? [{ title: w.title, ...partPath(locale, pid, partId, w.href) }] : [];
});
---
<Base title={`${piece.title} — Patrick Diaz`} description={piece.tagline} lang={locale} path={both ? `/${piece.id}/` : undefined}>
  <main id="main" class="page piece-page">
    <header class="piece-head">
      <p class="label piece-crumb"><a class="is-accent" href={localePath(locale, "/")}>Patrick Diaz</a> <span aria-hidden="true">–</span> {t(locale, "piece.label")} {n}</p>
      <h1>{piece.title}</h1>
      <div class="piece-intro">
        <div class="piece-lede">
          <p class="piece-tagline lead marked">{piece.tagline}</p>
          <p class="label">{t(locale, "piece.asOf")} {piece.as_of}</p>
        </div>
        <p class="piece-summary">{piece.summary}</p>
      </div>
    </header>
    {piece.chips.length > 0 && (
      <div class="piece-chips">
        <p class="label piece-chips-head" aria-hidden="true">{t(locale, "piece.measured")}</p>
        <div class="piece-chips-body"><Chips chips={piece.chips} locale={locale} footnote={piece.chips_note} /></div>
      </div>
    )}
    {start.length > 0 && (
      <nav class="piece-start" aria-labelledby="h-start">
        <h2 id="h-start" class="label">{t(locale, "piece.startHere")}</h2>
        <ul>
          {start.map((s) => (
            <li><a href={s.href} hreflang={s.lang}>{s.title}</a>{s.lang && <span class="label"> {t(locale, "map.englishPage")}</span>}</li>
          ))}
        </ul>
      </nav>
    )}
    <Map svg={piece.svg} parts={piece.parts} locale={locale} svgText={piece.svgText} />
  </main>
</Base>

<style>
  .piece-page { gap: var(--space-12); padding-top: var(--space-8); }
  .piece-head { display: grid; gap: var(--space-6); }
  .piece-head h1 { font-size: clamp(3.5rem, 12vw, 8rem); letter-spacing: -0.04em; line-height: 0.95; }
  /* The breadcrumb link gets a tap target of at least 24 px. */
  .piece-crumb a { display: inline-block; padding-block: var(--space-1); }
  .piece-intro { display: flex; flex-wrap: wrap; gap: var(--space-6) var(--space-12); align-items: start; margin-top: var(--space-2); }
  .piece-lede { flex: 2 1 20rem; min-width: 0; display: grid; gap: var(--space-3); }
  .piece-tagline { max-width: 30ch; }
  .piece-summary { flex: 3 1 24rem; min-width: 0; border-left: var(--line-thin) solid var(--color-border); padding-left: var(--space-6); }
  @media (max-width: 47.99rem) { .piece-summary { border-left: 0; padding-left: 0; } }
  .piece-chips { display: grid; gap: var(--space-3) var(--space-8); grid-template-columns: minmax(0, 1fr); }
  .piece-chips-body { display: grid; gap: var(--space-3); min-width: 0; }
  @media (min-width: 60rem) {
    .piece-chips { grid-template-columns: 9rem minmax(0, 1fr); }
    .piece-chips-head { padding-top: var(--space-3); }
  }
  .piece-start { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-8); align-items: baseline; border-block: var(--line-thin) solid var(--color-border); padding-block: var(--space-2); }
  .piece-start h2 { font-weight: 400; letter-spacing: var(--tracking-label); }
  .piece-start ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-6); }
  .piece-start a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: 0.9375rem; font-weight: 600; text-decoration: none; box-shadow: inset 0 -2px 0 transparent; }
  .piece-start a:hover { box-shadow: inset 0 -2px 0 var(--color-accent); }
</style>
