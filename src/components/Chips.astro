---
// A piece's measured results (aggregates only, D19), per language. Used on the piece overview
// and on the homepage (PLAN 1.9a). Since D25 each result sits under a thin orange rule; the
// numbers themselves stay monochrome.
import { t, type Locale } from "../i18n/ui.ts";
import { chipNote, chipValue } from "../lib/chips.ts";

interface Props {
  chips: { label: string; metric: string; value: number; n?: number; baseline?: number; note?: string; as_of: string }[];
  locale: Locale;
  /** One line under the results: what the numbers were measured on (2026-11-20). */
  footnote?: string;
}
const { chips, locale, footnote } = Astro.props;
---
{chips.length > 0 && (
  <ul class="chips" aria-label={t(locale, "piece.measured")}>
    {chips.map((c) => (
      <li class="chip">
        <span class="chip-value">{chipValue(c, locale)}</span>
        <span class="chip-label">{c.label}</span>
        <span class="label">{chipNote(c, locale).slice(0, -c.as_of.length)}<span class="chip-date">{c.as_of}</span></span>
      </li>
    ))}
  </ul>
)}
{chips.length > 0 && footnote && <p class="chips-footnote">{footnote}</p>}

<style>
  .chips { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-6) var(--space-8); }
  .chip { display: grid; gap: var(--space-2); align-content: start; border-top: var(--line-rule) solid var(--color-accent); padding-top: var(--space-3); min-width: 0; }
  .chip-value { font: 700 var(--step-3) / 1 var(--font-display); letter-spacing: var(--tracking-display); white-space: nowrap; }
  .chip-label { font-size: 1rem; line-height: 1.4; }
  /* A date never breaks at its hyphens. */
  .chip-date { white-space: nowrap; }
  .chips-footnote { font-size: var(--step--1); line-height: 1.5; color: var(--color-text-secondary); max-width: 70ch; }
</style>
