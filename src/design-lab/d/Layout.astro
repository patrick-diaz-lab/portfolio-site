---
// Direction D, "Minimal paper": the page shell. One line on top (the name, the project,
// contact, the other language, the mode), then a single column of text.
import "@fontsource/source-serif-4/latin-400.css";
import "@fontsource/source-serif-4/latin-400-italic.css";
import "@fontsource/source-serif-4/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import fontBody from "@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url";
import fontBold from "@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url";
import fontItalic from "@fontsource/source-serif-4/files/source-serif-4-latin-400-italic.woff2?url";
import "./tokens.css";
import "./styles.css";
import LabHead from "../shared/LabHead.astro";
import LabStrip from "../shared/LabStrip.astro";
import ThemeToggle from "../shared/ThemeToggle.astro";
import { labPath, type Lab, type LabPage } from "../shared/data.ts";
import { lt } from "../shared/ui.ts";
import { t } from "../../i18n/ui.ts";

interface Props {
  lab: Lab;
  page: LabPage;
  title: string;
  description: string;
}
const { lab, page, title, description } = Astro.props;
const { locale } = lab;
const other = locale === "en" ? "de" : "en";
const L = (k: Parameters<typeof lt>[1]) => lt(locale, k);
const home = labPath("d", locale, "home");
---
<!doctype html>
<html lang={locale}>
  <head>
    <LabHead title={title} description={description} scheme="light dark" preload={[fontBody, fontBold, fontItalic]} />
  </head>
  <body>
    <a class="skip" href="#main">{L("skip")}</a>
    <LabStrip dir="d" locale={locale} page={page} />
    <header class="page">
      <nav class="top" aria-label={L("nav")}>
        <a class="top-name" href={home}>Patrick Diaz</a>
        <ul>
          <li><a href={labPath("d", locale, "project")} aria-current={page === "project" ? "page" : undefined}>{lab.piece.title}</a></li>
          <li><a href={`${home}#h-contact`}>{L("contact")}</a></li>
          <li><a href={labPath("d", other, page)} hreflang={other} lang={other}>{t(other, `lang.${other}`)}</a></li>
          <li><ThemeToggle label={L("theme")} /></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="page">
      <p class="foot small">
        <a href={lab.privacyHref}>{t(locale, "footer.privacy")}</a>
        <a href={`mailto:${lab.site.email}`}>{lab.site.email}</a>
      </p>
    </footer>
  </body>
</html>
