---
// Design lab: the <head> every preview page shares. Always noindex, no canonical, no
// hreflang alternates and no social tags: a preview is never a page of the site.
interface Props {
  title: string;
  description: string;
  /** "light dark" for a direction with both modes, "dark" for a dark-only one. */
  scheme: "light dark" | "dark";
  /** Font files of the first paint, preloaded so the swap doesn't shift the layout. */
  preload: string[];
}
const { title, description, scheme, preload } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex" />
<meta name="color-scheme" content={scheme} />
{preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='2' fill='%231e2225'/%3E%3Ccircle cx='8' cy='8' r='4' fill='%23f2b23e'/%3E%3C/svg%3E" />
<meta name="description" content={description} />
<title>{title}</title>
{scheme === "light dark" && (
  <script is:inline>
    try { var m = localStorage.getItem("lab-theme"); if (m === "light" || m === "dark") document.documentElement.dataset.theme = m; } catch (e) {}
  </script>
)}
