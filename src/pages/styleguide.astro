---
// Style sheet page (PLAN 1.1 done-when): renders every token. Colors and their contrast
// ratios are read from tokens.css itself, so this page can't drift from the tokens.
import Base from "../layouts/Base.astro";
import tokensCss from "../styles/tokens.css?raw";

const rootBlock = tokensCss.slice(0, tokensCss.indexOf("@media"));
const colors = [...rootBlock.matchAll(/--color-([\w-]+):\s*(#[0-9a-f]{6});\s*\/\*\s*(.*?)\s*\*\//gi)].map((m) => ({
  name: m[1]!,
  hex: m[2]!.toLowerCase(),
  use: m[3]!,
}));
const steps = [...rootBlock.matchAll(/--(step-+\d):\s*([\d.]+rem)/g)].map((m) => ({ name: m[1]!, size: m[2]! }));
const spaces = [...rootBlock.matchAll(/--(space-\d+):\s*([\d.]+rem)/g)].map((m) => ({ name: m[1]!, size: m[2]! }));

function lum(hex: string): number {
  const c = (hex.slice(1).match(/../g) ?? []).map((h) => parseInt(h, 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0]! + 0.7152 * c[1]! + 0.0722 * c[2]!;
}
function ratio(a: string, b: string): number {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p) as [number, number];
  return (x + 0.05) / (y + 0.05);
}
const hexOf = (n: string) => colors.find((c) => c.name === n)?.hex ?? "#000000";
const grounds = ["panel", "panel-raised"];
const inks = ["silk", "silk-dim", "amber"];
const pairs = inks.flatMap((ink) => grounds.map((g) => ({ ink, ground: g, r: ratio(hexOf(ink), hexOf(g)) })));
---
<Base title="Style sheet · Bench instrument" description="Design tokens of patrickdiaz.dev" noindex>
  <main class="page sg">
    <header class="sg-head">
      <p class="label">Panel 01 · Style sheet · D13</p>
      <h1>Bench instrument</h1>
      <p>Every token of the design system. A graphite panel, silk-screened labels and one amber trace. Dark only. Every pair below must meet WCAG AA: 4.5:1 for text, 3:1 for lines and focus marks.</p>
    </header>

    <section aria-labelledby="h-color" class="sg-sec">
      <h2 id="h-color">Color</h2>
      <ul class="swatches" role="list">
        {colors.map((c) => (
          <li class="swatch">
            <span class="chip" style={`background:${c.hex}`}></span>
            <span class="label">--color-{c.name}</span>
            <span class="mono">{c.hex}</span>
            <span class="use">{c.use}</span>
          </li>
        ))}
      </ul>
      <table class="ratios">
        <caption class="label">Contrast, computed from tokens.css</caption>
        <thead><tr><th scope="col">Ink</th><th scope="col">On</th><th scope="col">Ratio</th><th scope="col">AA text 4.5:1</th></tr></thead>
        <tbody>
          {pairs.map((p) => (
            <tr>
              <td><span style={`color:var(--color-${p.ink})`}>{p.ink}</span></td>
              <td>{p.ground}</td>
              <td class="mono">{p.r.toFixed(2)}:1</td>
              <td class="mono">{p.r >= 4.5 ? "pass" : "FAIL"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section aria-labelledby="h-type" class="sg-sec">
      <h2 id="h-type">Type</h2>
      <div class="faces">
        <div class="module"><p class="label">Body · Barlow 400 / 600 / italic</p><p>Every model call goes through one gateway. <strong>Aliases only</strong>, prices pinned by hand, <em>one budget per flow</em>.</p></div>
        <div class="module"><p class="label">Panel · Barlow Condensed 600</p><p class="panel-sample">Gateway · Agent core · Evals</p></div>
        <div class="module"><p class="label">Labels and values · JetBrains Mono 400</p><p class="mono">hit@5 0.875 · $0.0023 · 40/40</p></div>
      </div>
      <ol class="scale" role="list">
        {steps.map((s) => (
          <li><span class="label">--{s.name} · {s.size}</span><span style={`font-size:var(--${s.name})`}>Agent core: routing and tool use</span></li>
        ))}
      </ol>
      <div class="module measure">
        <p class="label">Running text · --measure 65ch · --leading-body 1.6</p>
        <p>A local model classifies each message as simple or complex. Simple messages go to the cheap alias, complex ones to the smart alias with read-only tools. If the classifier is slow or the PC is off, the message goes to the smart alias, so a fallback keeps capability instead of only saving money.</p>
      </div>
    </section>

    <section aria-labelledby="h-space" class="sg-sec">
      <h2 id="h-space">Spacing</h2>
      <ul class="spaces" role="list">
        {spaces.map((s) => (
          <li><span class="bar" style={`width:var(--${s.name})`}></span><span class="label">--{s.name} · {s.size}</span></li>
        ))}
      </ul>
    </section>


    <section aria-labelledby="h-interact" class="sg-sec">
      <h2 id="h-interact">Links and focus</h2>
      <p>Links are silkscreen and underlined, amber on hover. Focus is a 2px amber outline with a 3px offset on every interactive element: press Tab to see it.</p>
      <p><a href="#h-color">A link to the colors</a> · <button type="button" class="btn">A button</button> · <code>inline code</code></p>
    </section>

    <section aria-labelledby="h-schematic" class="sg-sec">
      <h2 id="h-schematic">Schematic elements</h2>
      <p>Modules, a wire, a dimension mark and an amber note. Hover or focus a module: the signal dot runs along the wire (it stays still under reduced motion).</p>
      <div class="schematic-wrap">
        <svg class="schematic" viewBox="0 0 640 230" role="group" aria-labelledby="schem-title">
          <title id="schem-title">Sample: gateway, agent core and evals joined by one wire</title>
          <path class="wire" d="M170 80 H245 M395 80 H470" />
          <circle class="signal-dot" r="5" style="offset-path: path('M170 80 H470')" />
          <a class="part" href="#h-schematic" aria-label="Gateway: LiteLLM, built"><rect x="30" y="50" width="140" height="60" /><text x="100" y="86" text-anchor="middle">GATEWAY</text></a>
          <a class="part" href="#h-schematic" aria-label="Agent core: routing and tools, built"><rect x="245" y="50" width="150" height="60" /><text x="320" y="86" text-anchor="middle">AGENT CORE</text></a>
          <a class="part" href="#h-schematic" aria-label="Evals: eval harness, built"><rect x="470" y="50" width="140" height="60" /><text x="540" y="86" text-anchor="middle">EVALS</text></a>
          <path class="dim" d="M30 130 V142 M170 130 V142 M30 136 H170" />
          <text class="dim-t" x="100" y="158" text-anchor="middle">4 aliases</text>
          <path class="dim" d="M245 130 V142 M395 130 V142 M245 136 H395" />
          <text class="dim-t" x="320" y="158" text-anchor="middle">≤ 6 tool calls</text>
          <path class="note-line" d="M540 110 C540 165, 500 185, 450 196" />
          <text class="note" x="250" y="202">HELD-OUT SETS: TOTALS ONLY</text>
        </svg>
      </div>
    </section>
  </main>
</Base>

<style>
  .sg-head, .sg-sec { display: grid; gap: var(--space-4); }
  .mono { font-family: var(--font-mono); font-size: var(--step--1); }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); gap: var(--space-4); }
  .swatch { display: grid; gap: var(--space-1); }
  .chip { display: block; height: 4rem; border: var(--line-thin) solid var(--color-silk-dim); border-radius: var(--radius); }
  .use { font-size: var(--step--1); color: var(--color-silk-dim); }
  .ratios { border-collapse: collapse; font-size: var(--step--1); width: 100%; max-width: 36rem; }
  .ratios caption { text-align: left; padding-bottom: var(--space-2); }
  .ratios th, .ratios td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: var(--line-thin) solid var(--color-silk-dim); }
  .ratios th { font-family: var(--font-mono); font-weight: 400; color: var(--color-silk-dim); }
  .faces { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-4); }
  .faces .module { display: grid; gap: var(--space-2); align-content: start; }
  .panel-sample { font-family: var(--font-panel); font-weight: 600; font-size: var(--step-2); letter-spacing: var(--tracking-panel); text-transform: uppercase; }
  .scale { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .scale li { display: grid; gap: var(--space-1); min-width: 0; overflow-wrap: anywhere; }
  .measure { display: grid; gap: var(--space-2); }
  .spaces { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .spaces li { display: flex; align-items: center; gap: var(--space-4); }
  .bar { display: block; height: var(--space-4); background: var(--color-amber); }
  .btn { font: 600 var(--step--1) / 1 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-panel); background: var(--color-silk); border: 0; border-radius: var(--radius); padding: var(--space-2) var(--space-3); cursor: pointer; }
  .btn:hover { background: var(--color-amber); }
  .schematic-wrap { overflow-x: auto; }
  .schematic { width: 100%; max-width: 44rem; min-width: 30rem; height: auto; display: block; }
  .schematic .wire { stroke: var(--color-silk); stroke-width: var(--line-module); fill: none; }
  .schematic .part rect { fill: var(--color-panel-raised); stroke: var(--color-silk); stroke-width: var(--line-module); }
  .schematic .part text { fill: var(--color-silk); font: 400 13px var(--font-mono); letter-spacing: 0.06em; }
  .schematic .part:hover rect { stroke: var(--color-amber); }
  .schematic .part:focus-visible { outline: none; }
  .schematic .part:focus-visible rect { stroke: var(--color-amber); stroke-width: 3px; }
  .schematic .dim { stroke: var(--color-silk-dim); stroke-width: var(--line-thin); fill: none; }
  .schematic .dim-t { fill: var(--color-silk-dim); font: 400 11px var(--font-mono); }
  .schematic .note { fill: var(--color-amber); font: 600 16px var(--font-panel); letter-spacing: var(--tracking-panel); }
  .schematic .note-line { stroke: var(--color-amber); stroke-width: 1.2; fill: none; stroke-dasharray: 3 3; }
</style>
