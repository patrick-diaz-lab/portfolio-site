---
// Style sheet page (PLAN 1.1 done-when; D25): renders every token. Colors and their contrast
// ratios are read from tokens.css itself, in both modes, so this page can't drift from the
// tokens. Internal: noindex, not linked.
import Base from "../layouts/Base.astro";
import tokensCss from "../styles/tokens.css?raw";
import "../styles/schematic.css";

// Light values and what each color is for come from the :root block; dark values from the
// block for the visitor's own choice of dark.
const rootBlock = tokensCss.slice(tokensCss.indexOf(":root {"), tokensCss.indexOf("/* Dark mode."));
const darkBlock = tokensCss.slice(tokensCss.indexOf(':root[data-theme="dark"] {'));
const darkOf = Object.fromEntries([...darkBlock.slice(0, darkBlock.indexOf("}")).matchAll(/--color-([\w-]+):\s*(#[0-9a-f]{6});/gi)].map((m) => [m[1]!, m[2]!.toLowerCase()]));
const colors = [...rootBlock.matchAll(/--color-([\w-]+):\s*(#[0-9a-f]{6});\s*\/\*\s*(.*?)\s*\*\//gi)].map((m) => ({
  name: m[1]!,
  light: m[2]!.toLowerCase(),
  dark: darkOf[m[1]!] ?? m[2]!.toLowerCase(),
  use: m[3]!,
}));
const steps = [...rootBlock.matchAll(/--(step-+\d):\s*([\d.]+rem)/g)].map((m) => ({ name: m[1]!, size: m[2]! }));
const spaces = [...rootBlock.matchAll(/--(space-\d+):\s*([\d.]+rem)/g)].map((m) => ({ name: m[1]!, size: m[2]! }));

function lum(hex: string): number {
  const c = (hex.slice(1).match(/../g) ?? []).map((h) => parseInt(h, 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0]! + 0.7152 * c[1]! + 0.0722 * c[2]!;
}
function ratio(a: string, b: string): number {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p) as [number, number];
  return (x + 0.05) / (y + 0.05);
}
const hexOf = (n: string, mode: "light" | "dark") => colors.find((c) => c.name === n)?.[mode] ?? "#000000";
// Every pair the site sets as text, and what it must reach.
const pairs = [
  ["text", "bg", 4.5], ["text", "surface", 4.5], ["text-secondary", "bg", 4.5], ["text-secondary", "surface", 4.5],
  ["accent", "bg", 4.5], ["accent", "surface", 4.5], ["on-accent", "accent", 4.5], ["text", "accent-subtle", 4.5],
].map(([ink, ground, min]) => ({ ink: String(ink), ground: String(ground), min: Number(min), light: ratio(hexOf(String(ink), "light"), hexOf(String(ground), "light")), dark: ratio(hexOf(String(ink), "dark"), hexOf(String(ground), "dark")) }));
---
<Base title="Style sheet · patrickdiaz.dev" description="Design tokens of patrickdiaz.dev" noindex>
  <main id="main" class="page sg">
    <header class="sg-head">
      <p class="label">Style sheet · D25</p>
      <h1>One orange</h1>
      <p>Every token of the design system. Monochrome paper and ink in a light and a dark mode, and one burnt orange that means: active, primary or significant. Every text pair below must meet WCAG AA, 4.5:1, in both modes.</p>
    </header>

    <section aria-labelledby="h-color" class="sg-sec">
      <h2 id="h-color">Color</h2>
      <ul class="swatches" role="list">
        {colors.map((c) => (
          <li class="swatch">
            <span class="chips"><span class="chip" style={`background:${c.light}`}></span><span class="chip" style={`background:${c.dark}`}></span></span>
            <span class="label">--color-{c.name}</span>
            <span class="mono">{c.light} · {c.dark}</span>
            <span class="use">{c.use}</span>
          </li>
        ))}
      </ul>
      <table class="ratios">
        <caption class="label">Contrast, computed from tokens.css</caption>
        <thead><tr><th scope="col">Ink</th><th scope="col">On</th><th scope="col">Light</th><th scope="col">Dark</th><th scope="col">AA text 4.5:1</th></tr></thead>
        <tbody>
          {pairs.map((p) => (
            <tr>
              <td>{p.ink}</td>
              <td>{p.ground}</td>
              <td class="mono">{p.light.toFixed(2)}:1</td>
              <td class="mono">{p.dark.toFixed(2)}:1</td>
              <td class="mono">{p.light >= p.min && p.dark >= p.min ? "pass" : "FAIL"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section aria-labelledby="h-type" class="sg-sec">
      <h2 id="h-type">Type</h2>
      <div class="faces">
        <div class="face"><p class="label">Reading · Inter 400 / 600 / italic</p><p>Every model call goes through one gateway. <strong>Aliases only</strong>, prices pinned by hand, <em>one budget per flow</em>.</p></div>
        <div class="face"><p class="label">Display · Inter Tight 700</p><p class="display-sample">Gateway, agent core, evals</p></div>
        <div class="face"><p class="label">Labels and values · JetBrains Mono 400</p><p class="mono">hit@5 0.875 · $0.0023 · 40/40</p></div>
      </div>
      <ol class="scale" role="list">
        {steps.map((s) => (
          <li><span class="label">--{s.name} · {s.size}</span><span style={`font-size:var(--${s.name})`}>Agent core: routing and tool use</span></li>
        ))}
      </ol>
      <div class="face measure">
        <p class="label">Running text · --measure 65ch · --leading-body 1.6</p>
        <p>A local model classifies each message as simple or complex. Simple messages go to the cheap alias, complex ones to the smart alias with read-only tools. If the classifier is slow or the PC is off, the message goes to the smart alias, so a broken classifier costs money, never an answer.</p>
      </div>
    </section>

    <section aria-labelledby="h-space" class="sg-sec">
      <h2 id="h-space">Spacing</h2>
      <ul class="spaces" role="list">
        {spaces.map((s) => (
          <li><span class="bar" style={`width:var(--${s.name})`}></span><span class="label">--{s.name} · {s.size}</span></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="h-interact" class="sg-sec">
      <h2 id="h-interact">Links, buttons and focus</h2>
      <p>Links are ink and underlined; the underline turns orange on hover. The primary button is the one orange surface; the quiet button is an outline. Focus is a 3px outline with a 3px offset on every interactive element: press Tab to see it.</p>
      <p class="sg-row"><a href="#h-color">A link to the colors</a> <button type="button" class="button">Primary button</button> <button type="button" class="button is-quiet">Quiet button</button> <code>inline code</code></p>
      <p class="lead marked">An introductory statement carries a thin orange marker.</p>
    </section>

    <section aria-labelledby="h-schematic" class="sg-sec">
      <h2 id="h-schematic">Drawings</h2>
      <p>Boxes, wires and lettering come from the tokens, so every drawing follows the mode. Orange has a meaning: a solid orange border is the component that does the main work, a solid orange arrow the main path, a dashed orange arrow a fallback, a dashed orange border a boundary, orange lettering a note. Hover or focus a part: the signal dot runs along the wire (it stays still under reduced motion).</p>
      <div class="plate">
        <svg class="schematic figure-svg" viewBox="0 0 640 250" role="group" aria-labelledby="schem-title">
          <title id="schem-title">Sample: an input, a key component with its main path, a fallback and a boundary</title>
          <path class="wire" d="M170 80 H245" />
          <path class="wire-key" d="M395 80 H461" />
          <polygon class="fig-head-key" points="469,80 461,76 461,84" />
          <circle class="signal-dot" r="5" style="offset-path: path('M170 80 H470')" />
          <a class="part" href="#h-schematic" aria-label="Input"><rect class="box" x="30" y="50" width="140" height="60" /><text class="lbl fig-mid" x="100" y="86">INPUT</text></a>
          <a class="part" href="#h-schematic" aria-label="Key part"><rect class="box key" x="245" y="50" width="150" height="60" /><text class="lbl fig-mid" x="320" y="86">KEY PART</text></a>
          <a class="part" href="#h-schematic" aria-label="Output"><rect class="box" x="470" y="50" width="140" height="60" /><text class="lbl fig-mid" x="540" y="86">OUTPUT</text></a>
          <path class="fig-fallback" d="M320 110 V151" />
          <polygon class="fig-head-amber" points="320,159 316,151 324,151" />
          <rect class="box" x="245" y="160" width="150" height="50" /><text class="lbl fig-mid" x="320" y="191">FALLBACK</text>
          <rect class="box boundary" x="470" y="160" width="140" height="50" /><text class="lbl fig-mid" x="540" y="191">ISOLATED</text>
          <path class="dim" d="M30 130 V142 M170 130 V142 M30 136 H170" />
          <text class="dim-t fig-mid" x="100" y="158">a dimension</text>
          <text class="note" x="30" y="236">a note that matters for reading the drawing</text>
        </svg>
      </div>
    </section>
  </main>
</Base>

<style>
  .sg { max-width: 64rem; }
  .sg-head, .sg-sec { display: grid; gap: var(--space-4); }
  .sg-sec { border-top: var(--line-rule) solid var(--color-text); padding-top: var(--space-4); }
  .mono { font-family: var(--font-mono); font-size: var(--step--1); }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: var(--space-6) var(--space-4); }
  .swatch { display: grid; gap: var(--space-1); }
  .chips { display: grid; grid-template-columns: 1fr 1fr; }
  .chip { display: block; height: 3.5rem; border: var(--line-thin) solid var(--color-border); }
  .use { font-size: var(--step--1); color: var(--color-text-secondary); }
  .ratios { border-collapse: collapse; font-size: var(--step--1); width: 100%; max-width: 44rem; }
  .ratios caption { text-align: left; padding-bottom: var(--space-2); }
  .ratios th, .ratios td { text-align: left; padding: var(--space-2) var(--space-3) var(--space-2) 0; border-bottom: var(--line-thin) solid var(--color-border); }
  .ratios th { font-family: var(--font-mono); font-weight: 400; color: var(--color-text-secondary); }
  .faces { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-6); }
  .face { display: grid; gap: var(--space-2); align-content: start; border-top: var(--line-thin) solid var(--color-border); padding-top: var(--space-3); }
  .display-sample { font: 700 var(--step-2) / 1.1 var(--font-display); letter-spacing: var(--tracking-display); }
  .scale { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .scale li { display: grid; gap: var(--space-1); min-width: 0; overflow-wrap: anywhere; font-family: var(--font-display); font-weight: 700; letter-spacing: var(--tracking-display); line-height: 1.1; }
  .scale .label { font-weight: 400; }
  .spaces { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .spaces li { display: flex; align-items: center; gap: var(--space-4); }
  .bar { display: block; height: 0.75rem; background: var(--color-text); }
  .sg-row { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; max-width: none; }
  /* The sample's parts show keyboard focus as an orange stroke on their box. */
  .sg :global(.schematic .part:focus-visible rect) { stroke: var(--color-accent); stroke-width: 3; }
</style>
