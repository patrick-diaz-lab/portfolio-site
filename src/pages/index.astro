---
// Hello page (PLAN 0.4), now on the design system (PLAN 1.1), with links to the pieces
// (PLAN 1.3). Not indexed until launch.
import Base from "../layouts/Base.astro";
import { loadPieces } from "../lib/pieces.ts";
const pieces = loadPieces();
---
<Base title="Patrick Diaz — AI/LLM engineer" description="Portfolio of Patrick Diaz, AI/LLM engineer: the systems I build and how I test them." noindex>
  <main class="page">
    <div style="display:grid;gap:var(--space-4)">
      <p class="label">Panel 00 · Under construction</p>
      <h1>Patrick Diaz — AI/LLM engineer</h1>
      <p>Portfolio under construction.</p>
      {pieces.length > 0 && (
        <ul style="margin:0;padding-left:var(--space-6)">
          {pieces.map((p) => <li><a href={`/${p.id}/`}>{p.title}</a>: {p.tagline}</li>)}
        </ul>
      )}
    </div>
  </main>
</Base>
