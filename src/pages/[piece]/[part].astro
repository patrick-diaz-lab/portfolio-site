---
// Part page, English (PLAN 1.4): one page per content/parts/<piece>/<part>.mdx of a built
// piece. The page itself is src/components/PartPage.astro; German: src/pages/de/[piece]/[part].astro.
import { getCollection } from "astro:content";
import PartPage from "../../components/PartPage.astro";
import { loadPieces } from "../../lib/pieces.ts";

export async function getStaticPaths() {
  // Part pages only for built pieces (Patrick, 2026-11-13).
  const built = new Set(loadPieces("en").map((p) => p.id));
  const parts = (await getCollection("parts")).filter((p) => built.has(p.data.piece));
  const knowledge = await getCollection("knowledge");
  return parts.map((part) => ({
    params: { piece: part.data.piece, part: part.data.id },
    props: {
      part,
      entries: knowledge
        .filter((k) => k.data.piece === part.data.piece && k.data.part === part.data.id)
        .sort((a, b) => a.id.localeCompare(b.id)),
    },
  }));
}

const { part, entries } = Astro.props;
---
<PartPage locale="en" part={part} entries={entries} />
