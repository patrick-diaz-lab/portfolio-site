---
// Piece overview, English (PLAN 1.3): one page per folder in pieces/, so a second piece
// needs no code change. German: src/pages/de/[piece]/index.astro (PLAN 1.9a).
import PieceOverview from "../../components/PieceOverview.astro";
import { loadPieces } from "../../lib/pieces.ts";

export function getStaticPaths() {
  return loadPieces("en").map((piece) => ({ params: { piece: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
---
<PieceOverview piece={piece} locale="en" />
