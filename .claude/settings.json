{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(*core.hooksPath*)",
      "Bash(*git -c core.*)",
      "Bash(gh pr merge*)",
      "Bash(*gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push http*)",
      "Bash(git push git@*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__update_pull_request_branch"
    ]
  }
}
