// Cloudflare Worker with static assets only (D7, PLAN 0.4): no Worker script, no bindings.
// Deployed by Cloudflare's Git build on merges to main; builds for other branches are off.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-site",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The custom domain patrickdiaz.dev is attached in the dashboard (PLAN 1.9b, STEPS D):
  // routes stay out of this file, so a deploy never needs the right to create domains.
  // workers.dev stays on as a fallback until the domain has served for a while.
  "workers_dev": true,
  // No preview URLs for uploaded versions (D3: no public previews).
  "preview_urls": false,
  // Worker logs and traces off (D7, D11).
  "observability": { "enabled": false }
}
